generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      Job[]

  @@index([createdAt])
}

model Order {
  id           String   @id @default(cuid())
  jobId        String   @unique
  package      Float    @default(0)
  advance      Float    @default(0)
  due          Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  installments Json?
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Job {
  id              String          @id @default(cuid())
  clientId        String
  category        String          @default("General Printing")
  date            DateTime
  time            String
  location        String
  status          String          @default("Confirmed")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  contractUrl     String?
  proofUrl        String?         @map("galleryUrl")
  attachments     Json?
  jobNumber       String?         @unique
  createdById     String?
  customData      Json?
  deletedAt       DateTime?
  inclusions      Json?
  notes           String?
  packageName     String?
  updatedById     String?
  proofDelivered  Boolean         @default(false) @map("galleryDelivered")
  finishingStatus FinishingStatus @default(PENDING) @map("albumStatus")
  /// Production stage (board column), derived from the layout status field on every save.
  stage           String?
  /// Delivery due date (calendar date, UTC midnight), derived from the layout due-date field.
  dueDate         DateTime?
  /// Queue priority (Urgent first). Board columns and team queues sort by it.
  priority        JobPriority     @default(NORMAL)
  /// Hand-set place in its queue within the same priority; null joins the end (by due date).
  queuePosition   Float?
  client          Client          @relation(fields: [clientId], references: [id])
  createdBy       User?           @relation("JobCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?           @relation("JobUpdatedBy", fields: [updatedById], references: [id])
  order           Order?
  invoice         Invoice?
  transactions    Transaction[]
  assignments     JobAssignment[]
  activities      JobActivity[]

  @@index([clientId])
  @@index([status])
  @@index([deletedAt, date])
  @@index([clientId, date])
  @@index([deletedAt, stage])
  @@index([deletedAt, dueDate])
  @@index([deletedAt, stage, priority, queuePosition])
}

model SystemLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Transaction {
  id             String          @id @default(cuid())
  amount         Float
  type           TransactionType
  date           DateTime
  category       String
  paymentMode    String
  description    String?
  status         String          @default("SETTLED")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  attachmentUrl  String?
  jobId          String?
  customData     Json?
  transactionId  String?         @unique
  userId         String?
  productOrderId String?
  deletedAt      DateTime?
  groupId        String?
  job            Job?            @relation(fields: [jobId], references: [id])
  productOrder   ProductOrder?   @relation(fields: [productOrderId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])

  @@index([date])
  @@index([category])
  @@index([type])
  @@index([paymentMode])
  @@index([userId])
  @@index([date, type])
  @@index([userId, date])
  @@index([deletedAt, date])
  @@index([jobId])
  @@index([productOrderId])
  @@index([groupId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String?            @unique
  emailVerified      DateTime?
  password           String?
  image              String?
  emailNotifications Boolean            @default(true)
  idNumber           Int                @default(autoincrement())
  invitedAt          DateTime?
  phone              String?
  pushNotifications  Boolean            @default(true)
  role               Role               @default(STAFF)
  /// Set exactly when role is CUSTOM (enforced by a check constraint).
  customRoleId       String?
  customRole         CustomRole?        @relation(fields: [customRoleId], references: [id], onDelete: Restrict)
  status             UserStatus         @default(ACTIVE)
  whatsappNotifs     Boolean            @default(false)
  notificationPrefs  Json?
  accounts           Account[]
  createdJobs        Job[]              @relation("JobCreatedBy")
  updatedJobs        Job[]              @relation("JobUpdatedBy")
  categoryBudgets    CategoryBudget[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  sessions           Session[]
  transactions       Transaction[]
  integrations       UserIntegration[]
  jobAssignments     JobAssignment[]    @relation("JobAssignee")
  assignedJobs       JobAssignment[]    @relation("JobAssigner")
  jobActivities      JobActivity[]
  teams              TeamMember[]

  @@index([status])
  @@index([customRoleId])
}

/// A role an admin builds from scratch or clones from another role. Holds its own permission list.
model CustomRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model UserIntegration {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  connectedEmail String?
  customData     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model RolePermission {
  id         String  @id @default(cuid())
  role       Role
  permission String
  enabled    Boolean @default(false)

  @@unique([role, permission])
  @@index([role])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@index([email])
}

/// Fixed-window counters for rate limiting (login, password reset). Shared across instances.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

/// Monotonic named sequences (e.g. invoice numbers). Incremented atomically.
model Counter {
  key   String @id
  value Int    @default(0)
}

/// One row per reminder actually sent, so cron retries and daily runs never re-notify.
model ReminderLog {
  key       String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Product {
  id          String         @id @default(cuid())
  name        String
  description String?
  price       Float
  stock       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  orders      ProductOrder[]

  @@index([createdAt])
}

model ProductOrder {
  id             String        @id @default(cuid())
  productId      String
  quantity       Int           @default(1)
  status         String        @default("PENDING")
  clientName     String
  clientPhone    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customData     Json?
  orderNumber    String?       @unique
  dueDate        DateTime?
  discountAmount Float         @default(0)
  date           DateTime      @default(now())
  product        Product       @relation(fields: [productId], references: [id])
  transactions   Transaction[]

  @@index([productId])
  @@index([status])
  @@index([date])
  @@index([createdAt])
}

model FormLayout {
  id          String   @id @default(cuid())
  formKey     String   @unique
  name        String
  description String?
  schema      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id           String               @id @default(cuid())
  userId       String
  title        String
  message      String
  isRead       Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  actionUrl    String?
  entityId     String?
  entityType   String?
  type         NotificationType
  link         String?
  priority     NotificationPriority @default(NORMAL)
  snoozedUntil DateTime?
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([type, entityId, createdAt])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecycleBin {
  id           String   @id @default(cuid())
  itemType     String
  itemId       String
  originalData Json
  trashedById  String?
  trashedAt    DateTime @default(now())

  @@index([itemType])
  @@index([trashedAt])
}

model CategoryBudget {
  id           String   @id @default(cuid())
  category     String
  monthlyLimit Float
  month        Int
  year         Int
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([category, month, year, userId])
  @@index([userId])
  @@index([category, month, year])
}

/// ADMIN (full access, manages the team), MANAGER and STAFF (editable defaults), CUSTOM (see User.customRole).
enum Role {
  ADMIN
  MANAGER
  STAFF
  CUSTOM
}

enum UserStatus {
  ACTIVE
  PENDING
  INACTIVE
}

/// Post-press finishing (binding, lamination, framing, cutting).
enum FinishingStatus {
  PENDING
  IN_PROGRESS
  DELIVERED

  @@map("AlbumStatus")
}

enum NotificationType {
  JOB_CREATED
  JOB_UPDATED
  PAYMENT_RECEIVED
  PAYMENT_OVERDUE
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  ORDER_DELIVERED
  PROOF_DELIVERED            @map("GALLERY_DELIVERED")
  HOT_DATE_ALERT
  ORDER_STATUS_STALE
  JOB_STATUS_STALE
  PAYMENT_DUE_REMINDER
  ADVANCE_NOT_COLLECTED
  PROOF_NOT_DELIVERED        @map("GALLERY_NOT_DELIVERED")
  FINISHING_PENDING_REMINDER @map("ALBUM_PENDING_REMINDER")
  BUDGET_EXCEEDED
  JOB_ASSIGNED
}

/// Who a job is assigned to. Users without `view_all_jobs` only see jobs assigned to them.
model JobAssignment {
  jobId        String
  userId       String
  assignedById String?
  assignedAt   DateTime @default(now())
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user         User     @relation("JobAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User?    @relation("JobAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([jobId, userId])
  @@index([userId, assignedAt])
}

/// Per-job audit trail (admin-only). Written in the same DB transaction as the change it describes.
model JobActivity {
  id        String          @id @default(cuid())
  jobId     String
  actorId   String?
  type      JobActivityType
  summary   String
  /// [{ field, label, from, to }] for field-level changes.
  changes   Json?
  createdAt DateTime        @default(now())
  job       Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor     User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt])
  @@index([actorId, createdAt])
}

enum JobActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNED
  UNASSIGNED
  PAYMENT_ADDED
  PAYMENT_UPDATED
  PAYMENT_DELETED
  PAYMENT_RESTORED
  INVOICE_GENERATED
  ATTACHMENT_ADDED
  PROOF_DELIVERED
  FINISHING_UPDATED
  DELETED
  RESTORED
  HANDED_OFF
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum NotificationPriority {
  HIGH
  NORMAL
  LOW
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  jobId         String    @unique
  discount      Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lineItems InvoiceLineItem[]

  @@index([createdAt])
  @@index([deletedAt])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  rate        Float
  amount      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum JobPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

/// A group of people (e.g. Design, Printing) that takes over jobs when they reach its stages.
model Team {
  id        String       @id @default(cuid())
  name      String       @unique
  color     String       @default("#3b82f6")
  /// Board stage labels this team works on. A stage belongs to at most one team.
  stages    String[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  members   TeamMember[]
}

model TeamMember {
  teamId  String
  userId  String
  addedAt DateTime @default(now())
  team    Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}
