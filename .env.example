# Copy to .env and fill in. Never commit real values.

# --- Required ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# 32+ random bytes, e.g. `openssl rand -base64 48`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Cron (required for /api/cron/*; requests must send `Authorization: Bearer $CRON_SECRET`) ---
CRON_SECRET=""

# --- Google Drive integration (optional; admins can instead paste these in Settings → Google Drive) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_API_KEY=""
NEXT_PUBLIC_GOOGLE_APP_ID=""
# "private" keeps uploads visible only to the uploader (default: anyone with the link can view)
DRIVE_LINK_SHARING=""

# --- Email notifications (optional) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"Add designer" <notifications@example.com>'

# --- Web push (optional) — generate with `npx web-push generate-vapid-keys` ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# --- Debugging ---
NEXTAUTH_DEBUG="false"
